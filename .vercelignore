# ==============================================================================
# AI-DAX Vercel Deployment Exclusions (.vercelignore)
# Target: Static Dashboard Frontend (Hosted on Vercel)
# Separates local OS affinity scheduling engine & tests from cloud static dashboard
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local Python Scheduling Engine & Backend Services
# ------------------------------------------------------------------------------
/src/
/api/
/config/
/scripts/
/tests/

# ------------------------------------------------------------------------------
# 2. Research Assets, LaTeX Paper & Benchmarking Datasets
# ------------------------------------------------------------------------------
/docs/
/paper/
/results/
/data/
/checkpoints/

# ------------------------------------------------------------------------------
# 3. Container & Kubernetes Infrastructure
# ------------------------------------------------------------------------------
/docker/
/k8s/
/Dockerfile
/docker-compose.yml
/Makefile
/.github/

# ------------------------------------------------------------------------------
# 4. Secrets, Credentials & Local Environments
# ------------------------------------------------------------------------------
.env*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
service-account*.json
*token*.json
client_secrets*.json

# ------------------------------------------------------------------------------
# 5. Python Build Systems, Packaging & Virtual Environments
# ------------------------------------------------------------------------------
/.venv/
/venv/
/env/
/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
/dist/
/build/
/pyproject.toml
/requirements*.txt

# ------------------------------------------------------------------------------
# 6. Developer Tooling & Operating System Files
# ------------------------------------------------------------------------------
.idea/
.vscode/
.DS_Store
Thumbs.db
ehthumbs.db
.editorconfig
.pre-commit-config.yaml
.secrets.baseline
/README.md
/SECURITY.md

# ------------------------------------------------------------------------------
# 7. Local Runtime Telemetry & Database Files (Local Agent only)
# ------------------------------------------------------------------------------
/pids.txt
/bandit_stats.json
/scheduler_log.csv
/env.json
/*.db
/*.sqlite
/*.sqlite3
/*.log

# ------------------------------------------------------------------------------
# 8. Unconditionally Preserve Static Frontend Assets
# Guarantees that HTML, CSS, JS, images, icons, fonts, and manifests in static/ are deployed
# ------------------------------------------------------------------------------
!static/
!static/**
