# ==============================================================================
# AI-DAX Comprehensive .gitignore
# Production-grade Git ignore specification for research, development & deployment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Files, Secrets & Private Credentials
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.local
.env.local
.env.production
.env.development
.env.staging
static/.env*
static/.env.local

# Allow tracked template
!.env.example

# Private Certificates, SSH Keys & API Tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
id_ed25519*
credentials.json
service-account*.json
*token*.json
client_secrets*.json

# ------------------------------------------------------------------------------
# 2. Python Virtual Environments & Build Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Packaging & distribution
dist/
build/
*.egg-info/
*.egg
.eggs/
wheels/
develop-eggs/
downloads/
eggs/
parts/
var/
sdist/

# Static typing and linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage and test reports
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# ------------------------------------------------------------------------------
# 3. IDE, Editor & Operating System Metadata
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.tmp
.DS_Store
Thumbs.db
ehthumbs.db

# ------------------------------------------------------------------------------
# 4. Runtime Artifacts & Dynamic Simulation Logs
# ------------------------------------------------------------------------------
pids.txt
scheduler_log.csv
bandit_stats.json
env.json

# Local databases (SQLite runtime files)
*.db
*.sqlite
*.sqlite3

# Log files and ephemeral terminal text dumps
*.log
pip_out.log
push_out.log
eval*.log
tmp*
temp/
*temp.txt
clean_output.txt
full_out.txt
deploy.txt
current_deploy_url.txt
models.txt
vercel_output.txt
test.html
test_aizen.html
static/vercel_clean.txt
static/vercel_out.txt
static/verified_url.txt
static/test_deploy.html

# Security raw scan output (protect unredacted tool dumps)
docs/security/scan-output/*
!docs/security/scan-output/.gitkeep
!docs/security/scan-output/README.md

# ------------------------------------------------------------------------------
# 5. Benchmark Output (Dynamic Runs & Profiler Dumps)
# Preserve benchmark scripts, configs, documentation, and baseline datasets
# ------------------------------------------------------------------------------
results/raw/
results/runs/
*.prof
*.out

# ------------------------------------------------------------------------------
# 6. Deployment Output (Vercel & Build Caches)
# ------------------------------------------------------------------------------
.vercel/
.vercel
static/.vercel/
static/.vercel
