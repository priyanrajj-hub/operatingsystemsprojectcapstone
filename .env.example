# ==============================================================================
# AI-DAX Environment Configuration Template
# Instructions:
#   1. Copy this file to .env:
#      PowerShell:  Copy-Item .env.example .env
#      Bash:        cp .env.example .env
#   2. Populate the required values for your local environment.
#   3. NEVER commit the resulting .env file to Git or version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Networking
# ------------------------------------------------------------------------------
# Host interface to bind the FastAPI backend server (default: 127.0.0.1 for local isolation)
AIDAX_HOST=127.0.0.1

# Port for the FastAPI HTTP & WebSocket service
AIDAX_PORT=8000

# Enable debug mode (true/false) - NEVER enable in production
AIDAX_DEBUG=false

# Enable read-only mode (prevents changing OS CPU affinities; simulation mode)
AIDAX_READ_ONLY=false

# Comma-separated list of allowed CORS origins
AIDAX_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
AIDAX_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Security & Authentication
# ------------------------------------------------------------------------------
# API Bearer token required for sensitive operations if AIDAX_REQUIRE_AUTH is true.
# Generate a cryptographically secure token using: python scripts/gen_secret.py
AIDAX_API_TOKEN=change-me-with-scripts-gen-secret

# Enforce authentication headers on state-mutating endpoints (true/false)
AIDAX_REQUIRE_AUTH=false

# Global API request rate limit per IP per minute
AIDAX_RATE_LIMIT_PER_MINUTE=120

# ------------------------------------------------------------------------------
# 3. Third-Party AI Integration (Optional)
# ------------------------------------------------------------------------------
# Google Gemini API Key for Aizen OS insights and Jarvis voice assistant.
# Obtain a key from Google AI Studio: https://aistudio.google.com/
# If unset, the dashboard gracefully runs in local deterministic heuristic/simulation mode.
GEMINI_API_KEY=your-gemini-api-key-here

# ------------------------------------------------------------------------------
# 4. Storage & Persistence File Paths
# ------------------------------------------------------------------------------
# Local SQLite database URL for metrics persistence
AIDAX_DATABASE_URL=sqlite+aiosqlite:///aidax.db

# Path to process PID tracking file
AIDAX_PID_FILE=pids.txt

# Path to the CSV execution telemetry log
AIDAX_LOG_FILE=scheduler_log.csv

# Path to JSON bandit parameters and cumulative regret checkpoint
AIDAX_STATS_FILE=bandit_stats.json

# Directory for bandit checkpoints and model snapshots
AIDAX_CHECKPOINT_DIR=checkpoints

# Directory for benchmark and evaluation results
AIDAX_RESULTS_DIR=results

# ------------------------------------------------------------------------------
# 5. LinUCB Bandit Hyperparameters (Preregistered Defaults)
# ------------------------------------------------------------------------------
AIDAX_ALPHA_REWARD=0.7
AIDAX_BETA_REWARD=0.3
AIDAX_EXPLORATION=1.5
AIDAX_COLD_START_THRESHOLD=20
