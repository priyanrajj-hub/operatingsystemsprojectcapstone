# ==============================================================================
# AI-DAX Environment Configuration Example
# Copy this file to .env and fill in your values
# ==============================================================================

# Optional: Google Gemini API key for Aizen & Jarvis LLM assistant features
GEMINI_API_KEY=your_gemini_api_key_here

# Runtime File Path Overrides (Defaults)
AIDAX_LOG_FILE=scheduler_log.csv
AIDAX_PID_FILE=pids.txt
AIDAX_STATS_FILE=bandit_stats.json
